# Local dev defaults for docker-compose. Copy this file to `.env` (already
# gitignored) and adjust if you like — these placeholder values are fine for
# a local learning environment and are never meant to reach a real deployment.

# --- Postgres --------------------------------------------------------------
# One shared container, one shared superuser credential (ADR-0002): every
# service needs CREATEDB to self-provision its own logical database via EF
# Core Migrate() at startup, so there are no per-service roles here. Compose
# does not create or seed any tenant database — POSTGRES_DB below is just the
# default administrative database Postgres itself requires to boot; services
# create their own databases on top of this same server.
POSTGRES_USER=notification_platform
POSTGRES_PASSWORD=notification_platform_dev
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_USER=notification_platform
RABBITMQ_PASSWORD=notification_platform_dev
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Redis -------------------------------------------------------------------
REDIS_PORT=6379

# --- Aspire Dashboard ----------------------------------------------------------
# UI port and OTLP gRPC ingest port. Services point OTEL_EXPORTER_OTLP_ENDPOINT
# at http://aspire-dashboard:18889 (the in-network port, not the published
# host port below).
ASPIRE_DASHBOARD_UI_PORT=18888
ASPIRE_DASHBOARD_OTLP_PORT=18889

# --- Notification API (issue #8) ----------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
NOTIFICATION_API_PORT=5080
# Self-issued dev JWT signing key (docs/research/self-issued-jwt-auth.md on
# branch research/self-issued-jwt-auth). HS256 needs >= 32 bytes; generate
# your own with `openssl rand -base64 32` rather than reusing this placeholder
# anywhere it matters. Deliberately never a production auth pattern - see the
# research doc's caveat.
JWT_SIGNING_KEY=dev-only-notification-platform-signing-key-change-me
